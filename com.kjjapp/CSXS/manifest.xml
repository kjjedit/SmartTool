<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.kjjedit.smartpanel" ExtensionBundleVersion="1.0.0" ExtensionBundleName="SmartTool">
    <ExtensionList>
        <Extension Id="com.kjjedit.SmartTool" Version="1.0.0" />
        <Extension Id="com.kjjedit.SmartSearch" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[15.0,99.9]" />
        </HostList>
        <LocaleList><Locale Code="All" /></LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.kjjedit.SmartTool">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>SmartTool</Menu>
                    <Geometry><Size><Height>600</Height><Width>350</Width></Size></Geometry>
                </UI>
                <Network>
                    <Domain name="raw.githubusercontent.com" />
                    <Domain name="github.com" />
                </Network>
            </DispatchInfo>
        </Extension>

        <Extension Id="com.kjjedit.SmartSearch">
            <DispatchInfo>
                <Resources>
                    <MainPath>./search.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                </Resources>
                <Lifecycle><AutoVisible>false</AutoVisible></Lifecycle>
                <UI>
                    <Type>Dialog</Type> <Menu>SmartSearch</Menu>
                    <Geometry>
                        <Size>
                            <Height>60</Height>
                            <Width>450</Width>
                        </Size>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>